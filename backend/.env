# ========================================================
# Placifly Environment Configuration
# ========================================================

# Gemini API Key (for interview AI evaluations)
GEMINI_API_KEY=

# Gmail SMTP Configuration (To send REAL verification emails to candidates)
# 1. Enter your Gmail address below
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password and paste below (no spaces)
PLACIFLY_SMTP_EMAIL=
PLACIFLY_SMTP_PASSWORD=
PLACIFLY_SMTP_HOST=smtp.gmail.com
PLACIFLY_SMTP_PORT=587
